# Anthropic (paid). Leave empty to use a free backend instead.
ANTHROPIC_API_KEY=
ARENA_HARD_CAP_USD=15
# Free fallback, tried in this order when there is no Anthropic key:
# GROQ_API_KEY, GEMINI_API_KEY, OPENROUTER_API_KEY, CEREBRAS_API_KEY, else local Ollama.
# Models are chosen by prefix: ollama:qwen2.5:7b, groq:llama-3.3-70b-versatile, gemini:gemini-3.8-flash,
# no prefix means Anthropic. Override any role with ARENA_{TARGET,DETECTOR,QUARANTINE,ATTACKER}_MODEL.
# GROQ_RPM=20          requests per minute per provider (defaults are unverified guesses)
# ARENA_NUM_CTX=8192   Ollama context; the call errors if a prompt gets close to it
# ARENA_TEMP=0         temperature for non-Anthropic backends
# OLLAMA_URL=http://localhost:11434
